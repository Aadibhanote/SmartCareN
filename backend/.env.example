# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Local development: mongodb://127.0.0.1:27017/smartcare
# MongoDB Atlas (Production): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
# NOTE: If password contains special characters like '@', URL-encode them (e.g. '@' -> '%40')
MONGODB_URI=mongodb://127.0.0.1:27017/smartcare

# JWT Authentication (use a minimum 32-character random string in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# Frontend Origin for CORS (comma-separated for multiple origins if needed)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional: Google Gemini AI Chatbot (Leave empty to use built-in offline smart FAQ fallback)
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Seed script initial admin credentials
ADMIN_EMAIL=admin@smartcare.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin
